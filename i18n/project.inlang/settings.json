{
  "$schema": "https://inlang.com/schema/project-settings",
  "baseLocale": "en",
  "locales": ["en", "fr"],
  "modules": [
    "https://cdn.jsdelivr.net/npm/@inlang/plugin-next-intl@2/dist/index.js"
  ],
  "plugin.inlang.nextIntl": {
    "pathPattern": {
      "app": "./messages/{locale}/app.json",
      "domain": "./messages/{locale}/domain.json",
      "catalog": "./messages/{locale}/catalog.json"
    }
  }
}
