# For manual or local runs. On the server, the Deploy workflow writes .env from the GitHub
# production environment. Never commit .env.

# Public API hostname; deployment renders it into the shared Caddy configuration.
DOMAIN=api.example.com

# Server image tag: "latest" follows new releases; a version such as 0.3.0 stays on it.
IMAGE_TAG=latest

# Postgres password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional log shipping to Grafana Cloud Loki (docs/deploying-the-server.md#logs). Set all of
# them and COMPOSE_PROFILES=logs; the Deploy workflow does this from the GitHub environment.
# COMPOSE_PROFILES=logs
# LOKI_URL=https://logs-prod-XXX.grafana.net/loki/api/v1/push
# LOKI_USER=
# LOKI_PASSWORD=
