<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>history.sessions %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@sessions@</string>
        <key>sessions</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld séance</string>
            <key>other</key>
            <string>%lld séances</string>
        </dict>
    </dict>
    <key>history.active.days %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld jour actif · balayez pour changer de mois</string>
            <key>other</key>
            <string>%lld jours actifs · balayez pour changer de mois</string>
        </dict>
    </dict>
    <key>history.sessions.unit %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@unit@</string>
        <key>unit</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>séance</string>
            <key>other</key>
            <string>séances</string>
        </dict>
    </dict>
    <key>live.connected %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@devices@</string>
        <key>devices</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld connecté</string>
            <key>other</key>
            <string>%lld connectés</string>
        </dict>
    </dict>
</dict>
</plist>
