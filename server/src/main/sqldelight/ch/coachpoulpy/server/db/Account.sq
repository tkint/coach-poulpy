insert:
INSERT INTO account (id, email, password_hash, language, health_consent_at, created_at)
VALUES (?, ?, ?, ?, ?, ?)
ON CONFLICT DO NOTHING;

byEmail:
SELECT id, email, language, confirmed_at FROM account WHERE lower(email) = lower(:email);

confirm:
UPDATE account SET confirmed_at = :confirmedAt WHERE id = :id AND confirmed_at IS NULL;

passwordHash:
SELECT password_hash FROM account WHERE lower(email) = lower(:email);

forSignIn:
SELECT id, password_hash, confirmed_at, disabled_at FROM account WHERE lower(email) = lower(:email);

byId:
SELECT id, email, role FROM account WHERE id = ?;

-- Makes the confirmed account with this address an admin. No row when there is none: an address
-- nobody confirmed can't be promoted by signing up with it first.
promote:
UPDATE account SET role = 'admin' WHERE lower(email) = lower(:email) AND confirmed_at IS NOT NULL AND role <> 'admin'
RETURNING id;

setPassword:
UPDATE account SET password_hash = :passwordHash WHERE id = :id;

passwordHashById:
SELECT password_hash FROM account WHERE id = ?;

-- Every row of the account goes with it: its tokens, sign-ins and links cascade.
delete:
DELETE FROM account WHERE id = ? RETURNING email;

-- What the admin sees of an account (#336): its state, never its data.
adminView:
SELECT id, email, role, confirmed_at, created_at, disabled_at FROM account WHERE lower(email) = lower(:email);

-- No row when the account is unknown or already disabled.
disable:
UPDATE account SET disabled_at = :disabledAt WHERE id = :id AND disabled_at IS NULL RETURNING id;

-- No row when the account is unknown or not disabled.
enable:
UPDATE account SET disabled_at = NULL WHERE id = :id AND disabled_at IS NOT NULL RETURNING id;
