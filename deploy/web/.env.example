# For manual or local runs of the website. On the server, the Deploy workflow writes .env from the
# GitHub production environment when it deploys "website". Never commit .env.

# The server's APP_NAME followed by -web.
APP_NAME=coach-poulpy-web

# The web app's hostname; deployment renders it into the shared Caddy configuration.
DOMAIN=app.example.com

# Web image tag: "latest" follows new releases; a version such as 0.3.0 stays on it.
IMAGE_TAG=latest
