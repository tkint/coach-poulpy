-- A session is an append-only event log; the execution row is its header.
CREATE TABLE execution (
    id TEXT NOT NULL PRIMARY KEY,
    source TEXT NOT NULL,
    workout_id TEXT,
    workout_version INTEGER,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    -- The workout's name and format when the session started: the workout may be renamed or deleted later.
    -- The format column keeps its older name, from when it held the workout type.
    title TEXT,
    workout_type TEXT,
    -- SessionTotals as JSON, written when the session ends, or later for sessions from before history.
    summary TEXT
);

CREATE TABLE execution_event (
    execution_id TEXT NOT NULL REFERENCES execution(id) ON DELETE CASCADE,
    seq INTEGER NOT NULL,
    at INTEGER NOT NULL,
    payload TEXT NOT NULL,
    PRIMARY KEY (execution_id, seq)
);

insertExecution:
INSERT INTO execution(id, source, workout_id, workout_version, started_at, ended_at, title, workout_type)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

finishExecution:
UPDATE execution SET ended_at = ? WHERE id = ?;

finished:
SELECT * FROM execution WHERE ended_at IS NOT NULL ORDER BY started_at DESC;

setDetails:
UPDATE execution SET title = ?, workout_type = ?, summary = ? WHERE id = ?;

setSummary:
UPDATE execution SET summary = ? WHERE id = ?;

-- Events are deleted explicitly: SQLite leaves foreign keys off unless asked.
deleteEvents:
DELETE FROM execution_event WHERE execution_id = ?;

deleteExecution:
DELETE FROM execution WHERE id = ?;

unfinished:
SELECT * FROM execution WHERE ended_at IS NULL ORDER BY started_at DESC LIMIT 1;

appendEvent:
INSERT INTO execution_event(execution_id, seq, at, payload)
VALUES (:executionId, (SELECT COALESCE(MAX(seq), -1) + 1 FROM execution_event WHERE execution_id = :executionId), :at, :payload);

events:
SELECT payload FROM execution_event WHERE execution_id = ? ORDER BY seq;

-- Sessions played to the end (their log ends with "finished"), not ones closed when left behind.
finishedSessionEnds:
SELECT e.ended_at FROM execution e
WHERE e.ended_at IS NOT NULL
  AND (SELECT payload FROM execution_event WHERE execution_id = e.id ORDER BY seq DESC LIMIT 1) LIKE '{"type":"finished"%'
ORDER BY e.ended_at;
