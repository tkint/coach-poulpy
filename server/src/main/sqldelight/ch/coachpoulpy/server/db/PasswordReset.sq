insert:
INSERT INTO password_reset_token (token_hash, account_id, created_at, expires_at) VALUES (?, ?, ?, ?);

-- How many links an account was sent lately, so nobody floods a mailbox.
sentSince:
SELECT count(*) FROM password_reset_token WHERE account_id = :accountId AND created_at > :since;

-- Removes the token and gives its account, so a link works once.
consume:
DELETE FROM password_reset_token WHERE token_hash = ? RETURNING account_id, expires_at;

deleteForAccount:
DELETE FROM password_reset_token WHERE account_id = ?;
