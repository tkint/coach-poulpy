# deploy.py renders DOMAIN from the app's .env into the shared edge's sites/ folder.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy coach-poulpy-server:8080
}
