-- Locks the account row for the rest of the transaction, so two pushes never interleave.
lockAccount:
SELECT id FROM account WHERE id = :accountId FOR UPDATE;

nextChange:
UPDATE account SET change_count = change_count + 1 WHERE id = :accountId RETURNING change_count;

lastChange:
SELECT change_count FROM account WHERE id = :accountId;

sessionById:
SELECT * FROM session WHERE account_id = :accountId AND id = :id;

insertSession:
INSERT INTO session (account_id, id, source, started_at, ended_at, workout_id, workout_version, title, format, totals, change_number)
VALUES (:accountId, :id, :source, :startedAt, :endedAt, :workoutId, :workoutVersion, :title, :format, CAST(:totals AS JSONB), :changeNumber);

updateSession:
UPDATE session SET source = :source, started_at = :startedAt, ended_at = :endedAt, workout_id = :workoutId,
    workout_version = :workoutVersion, title = :title, format = :format, totals = CAST(:totals AS JSONB), change_number = :changeNumber
WHERE account_id = :accountId AND id = :id;

markSessionDeleted:
UPDATE session SET deleted_at = :deletedAt, change_number = :changeNumber, totals = NULL, title = NULL
WHERE account_id = :accountId AND id = :id;

deleteEvents:
DELETE FROM session_event WHERE account_id = :accountId AND session_id = :sessionId;

hasEvent:
SELECT EXISTS (SELECT 1 FROM session_event WHERE account_id = :accountId AND session_id = :sessionId AND seq = :seq);

insertEvent:
INSERT INTO session_event (account_id, session_id, seq, at, payload, change_number)
VALUES (:accountId, :sessionId, :seq, :at, CAST(:payload AS JSONB), :changeNumber);

sessionsAfter:
SELECT id, source, started_at, ended_at, workout_id, workout_version, title, format, CAST(totals AS TEXT) AS totals, deleted_at, change_number
FROM session WHERE account_id = :accountId AND change_number > :after ORDER BY change_number LIMIT :limit;

eventsAfter:
SELECT session_id, seq, at, CAST(payload AS TEXT) AS payload, change_number
FROM session_event WHERE account_id = :accountId AND change_number > :after ORDER BY change_number LIMIT :limit;

workoutVersion:
SELECT CAST(content AS TEXT) FROM workout_version WHERE account_id = :accountId AND workout_id = :workoutId AND version = :version;

latestWorkoutVersion:
SELECT max(version) AS latest FROM workout_version WHERE account_id = :accountId AND workout_id = :workoutId;

insertWorkoutVersion:
INSERT INTO workout_version (account_id, workout_id, version, format, name, content, created_at, change_number)
VALUES (:accountId, :workoutId, :version, :format, :name, CAST(:content AS JSONB), :createdAt, :changeNumber);

workoutDeletion:
SELECT version FROM workout_deletion WHERE account_id = :accountId AND workout_id = :workoutId;

insertWorkoutDeletion:
INSERT INTO workout_deletion (account_id, workout_id, version, deleted_at, change_number)
VALUES (:accountId, :workoutId, :version, :deletedAt, :changeNumber);

undeleteWorkout:
DELETE FROM workout_deletion WHERE account_id = :accountId AND workout_id = :workoutId;

workoutVersionsAfter:
SELECT CAST(content AS TEXT) AS content, version, created_at, change_number
FROM workout_version WHERE account_id = :accountId AND change_number > :after ORDER BY change_number LIMIT :limit;

workoutDeletionsAfter:
SELECT workout_id, version, deleted_at, change_number
FROM workout_deletion WHERE account_id = :accountId AND change_number > :after ORDER BY change_number LIMIT :limit;

plannedWorkoutChangedAt:
SELECT changed_at FROM planned_workout WHERE account_id = :accountId AND id = :id;

-- Inserts or replaces a planned workout; the caller has checked the write is the latest.
writePlannedWorkout:
INSERT INTO planned_workout (account_id, id, workout_id, day, created_at, changed_at, deleted, change_number)
VALUES (:accountId, :id, :workoutId, :day, :createdAt, :changedAt, :deleted, :changeNumber)
ON CONFLICT (account_id, id) DO UPDATE SET workout_id = EXCLUDED.workout_id, day = EXCLUDED.day,
    changed_at = EXCLUDED.changed_at, deleted = EXCLUDED.deleted, change_number = EXCLUDED.change_number;

markPlannedWorkoutDeleted:
UPDATE planned_workout SET deleted = TRUE, changed_at = :changedAt, change_number = :changeNumber
WHERE account_id = :accountId AND id = :id;

measurementChangedAt:
SELECT changed_at FROM body_measurement WHERE account_id = :accountId AND metric = :metric AND day = :day;

writeMeasurement:
INSERT INTO body_measurement (account_id, metric, day, value, changed_at, change_number)
VALUES (:accountId, :metric, :day, :value, :changedAt, :changeNumber)
ON CONFLICT (account_id, metric, day) DO UPDATE SET value = EXCLUDED.value, changed_at = EXCLUDED.changed_at,
    change_number = EXCLUDED.change_number;

settingChangedAt:
SELECT changed_at FROM setting WHERE account_id = :accountId AND key = :key;

writeSetting:
INSERT INTO setting (account_id, key, value, changed_at, change_number)
VALUES (:accountId, :key, :value, :changedAt, :changeNumber)
ON CONFLICT (account_id, key) DO UPDATE SET value = EXCLUDED.value, changed_at = EXCLUDED.changed_at,
    change_number = EXCLUDED.change_number;

plannedWorkoutsAfter:
SELECT id, workout_id, day, created_at, changed_at, deleted, change_number
FROM planned_workout WHERE account_id = :accountId AND change_number > :after ORDER BY change_number LIMIT :limit;

measurementsAfter:
SELECT metric, day, value, changed_at, change_number
FROM body_measurement WHERE account_id = :accountId AND change_number > :after ORDER BY change_number LIMIT :limit;

settingsAfter:
SELECT key, value, changed_at, change_number
FROM setting WHERE account_id = :accountId AND change_number > :after ORDER BY change_number LIMIT :limit;

-- The latest version of each workout the account has not deleted, for the website's library.
latestWorkouts:
SELECT CAST(v.content AS TEXT) AS content
FROM workout_version v
WHERE v.account_id = :accountId
  AND v.version = (SELECT max(m.version) FROM workout_version m WHERE m.account_id = v.account_id AND m.workout_id = v.workout_id)
  AND NOT EXISTS (SELECT 1 FROM workout_deletion d WHERE d.account_id = v.account_id AND d.workout_id = v.workout_id);

latestWorkout:
SELECT CAST(v.content AS TEXT) AS content
FROM workout_version v
WHERE v.account_id = :accountId AND v.workout_id = :workoutId
  AND v.version = (SELECT max(m.version) FROM workout_version m WHERE m.account_id = v.account_id AND m.workout_id = v.workout_id)
  AND NOT EXISTS (SELECT 1 FROM workout_deletion d WHERE d.account_id = v.account_id AND d.workout_id = v.workout_id);

-- The sessions done of a workout (any of its versions) with the totals the phone saved; sessions without totals are left out.
workoutSessions:
SELECT workout_id, started_at, CAST(totals AS TEXT) AS totals
FROM session
WHERE account_id = :accountId AND workout_id IS NOT NULL AND deleted_at IS NULL AND totals IS NOT NULL;
