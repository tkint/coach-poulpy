-- The outbox (docs/accounts.md, Sync): each change a write made, as SyncChange JSON, oldest first.
-- It is filled only while the phone is signed in with a confirmed email.
CREATE TABLE sync_outbox (
    seq INTEGER PRIMARY KEY AUTOINCREMENT,
    change_json TEXT NOT NULL
);

-- One row, id 0: whether writes add their change to the outbox (1) or not (0, or no row: a guest).
CREATE TABLE sync_state (
    id INTEGER NOT NULL PRIMARY KEY CHECK (id = 0),
    recording INTEGER NOT NULL,
    -- Where the last pull stopped; none before the first.
    cursor TEXT
);

recording:
SELECT recording FROM sync_state WHERE id = 0;

ensureState:
INSERT OR IGNORE INTO sync_state(id, recording) VALUES (0, 0);

setRecording:
UPDATE sync_state SET recording = ? WHERE id = 0;

cursor:
SELECT cursor FROM sync_state WHERE id = 0;

setCursor:
UPDATE sync_state SET cursor = ? WHERE id = 0;

addChange:
INSERT INTO sync_outbox(change_json) VALUES (?);

outbox:
SELECT seq, change_json FROM sync_outbox ORDER BY seq LIMIT ?;

wholeOutbox:
SELECT seq, change_json FROM sync_outbox ORDER BY seq;

outboxSize:
SELECT COUNT(*) FROM sync_outbox;

rewriteChange:
UPDATE sync_outbox SET change_json = ? WHERE seq = ?;

removeChange:
DELETE FROM sync_outbox WHERE seq = ?;

removeUpTo:
DELETE FROM sync_outbox WHERE seq <= ?;

clearOutbox:
DELETE FROM sync_outbox;
