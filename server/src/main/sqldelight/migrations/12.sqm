-- The exercise catalog on the server (#337, ADR 0026): the admin edits a draft and publishes
-- numbered versions. Both keep one row per exercise, retired ones included, holding the shared
-- Exercise JSON (ADR 0007); the server assembles a version into the document phones store, in the
-- bundled JSON format (ADR 0008, ADR 0015). The server fills the tables from the bundled catalog the
-- first time it starts.

-- A published version. Its exercises never change once written.
CREATE TABLE catalog_version (
    version INTEGER PRIMARY KEY,
    published_at TIMESTAMPTZ NOT NULL
);

-- The exercises of a version. `position` keeps the catalog's order; an exercise in a variation group
-- has the group's number and its `variation_rank`, easiest first.
CREATE TABLE catalog_version_exercise (
    version INTEGER NOT NULL REFERENCES catalog_version (version),
    slug TEXT NOT NULL,
    position INTEGER NOT NULL,
    content JSONB NOT NULL,
    variation_group INTEGER,
    variation_rank INTEGER,
    PRIMARY KEY (version, slug)
);

-- The working draft, in the same shape. Rows are never deleted, since slugs never go away.
CREATE TABLE catalog_draft_exercise (
    slug TEXT PRIMARY KEY,
    position INTEGER NOT NULL,
    content JSONB NOT NULL,
    variation_group INTEGER,
    variation_rank INTEGER,
    updated_at TIMESTAMPTZ NOT NULL
);
