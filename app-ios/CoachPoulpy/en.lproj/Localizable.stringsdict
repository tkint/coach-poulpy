<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>history.sessions %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@sessions@</string>
        <key>sessions</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld session</string>
            <key>other</key>
            <string>%lld sessions</string>
        </dict>
    </dict>
    <key>history.active.days %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld active day · swipe for other months</string>
            <key>other</key>
            <string>%lld active days · swipe for other months</string>
        </dict>
    </dict>
    <key>history.sessions.unit %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@unit@</string>
        <key>unit</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>session</string>
            <key>other</key>
            <string>sessions</string>
        </dict>
    </dict>
    <key>live.connected %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@devices@</string>
        <key>devices</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld connected</string>
            <key>other</key>
            <string>%lld connected</string>
        </dict>
    </dict>
    <key>home.in.days %lld %@</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@days@ · %2$@</string>
        <key>days</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>In %lld day</string>
            <key>other</key>
            <string>In %lld days</string>
        </dict>
    </dict>
    <key>workout.times %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@times@</string>
        <key>times</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>%lld time</string>
            <key>other</key>
            <string>%lld times</string>
        </dict>
    </dict>
    <key>exercises.equipment.ticked %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Equipment, %lld ticked</string>
            <key>other</key>
            <string>Equipment, %lld ticked</string>
        </dict>
    </dict>
    <key>exercises.equipment.show %lld</key>
    <dict>
        <key>NSStringLocalizedFormatKey</key>
        <string>%#@count@</string>
        <key>count</key>
        <dict>
            <key>NSStringFormatSpecTypeKey</key>
            <string>NSStringPluralRuleType</string>
            <key>NSStringFormatValueTypeKey</key>
            <string>lld</string>
            <key>one</key>
            <string>Show %lld exercise</string>
            <key>other</key>
            <string>Show %lld exercises</string>
        </dict>
    </dict>
</dict>
</plist>
