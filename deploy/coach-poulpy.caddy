# The site served by the shared Caddy; deploy/caddy/deploy.py fills in DOMAIN from the app's .env.

{$DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy coach-poulpy-server:8080
}
