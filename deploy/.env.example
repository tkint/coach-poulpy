# Copy to .env next to compose.yaml and fill in. Never commit .env.

# Public API hostname; deployment renders it into the shared Caddy configuration.
DOMAIN=api.example.com

# Server image tag: "latest" follows new releases; a version such as 0.3.0 stays on it.
IMAGE_TAG=latest

# Postgres password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# The Docker network Caddy shares with the apps it serves.
# EDGE_NETWORK=edge
